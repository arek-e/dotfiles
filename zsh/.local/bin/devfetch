#!/bin/bash

# =============================================================================
# devfetch - Developer dashboard with style (full-width)
# =============================================================================

# Colors (Tokyo Night inspired) - using $'...' for proper escape interpretation
RESET=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'

BLUE=$'\033[38;5;111m'
PURPLE=$'\033[38;5;141m'
CYAN=$'\033[38;5;117m'
GREEN=$'\033[38;5;150m'
YELLOW=$'\033[38;5;222m'
ORANGE=$'\033[38;5;215m'
RED=$'\033[38;5;203m'
GRAY=$'\033[38;5;243m'
WHITE=$'\033[38;5;255m'

# Box drawing
H="─"
V="│"
TL="╭"
TR="╮"
BL="╰"
BR="╯"
L="├"
R="┤"

# Icons (Nerd Fonts)
GITHUB_ICON=""
PR_ICON=""
ISSUE_ICON=""
REVIEW_ICON=""
LINEAR_ICON=""
CHECK_ICON=""
USER_ICON=""
COMMIT_ICON=""
ARROW="›"
DOT="•"
CHECKMARK="✓"
CROSS="✗"

# Get terminal width
WIDTH=$(tput cols 2>/dev/null || echo 80)
[[ $WIDTH -gt 120 ]] && WIDTH=120
[[ $WIDTH -lt 50 ]] && WIDTH=50

# Cache settings
CACHE_DIR="$HOME/.cache/devfetch"
CACHE_TIMEOUT=300
mkdir -p "$CACHE_DIR"

# ─────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────

repeat_char() {
    local char="$1"
    local count="$2"
    printf "%${count}s" | tr ' ' "$char"
}

center_text() {
    local text="$1"
    local width="$2"
    local text_len=${#text}
    local pad=$(( (width - text_len) / 2 ))
    printf "%${pad}s%s" "" "$text"
}

draw_top_border() {
    local title="$1"
    local icon="$2"
    local color="$3"
    local title_with_icon=" ${icon} ${title} "
    local title_len=$((${#title} + 5))
    local right_padding=$((WIDTH - title_len - 4))

    printf "%s%s%s%s" "$color" "$TL" "$H$H" "$title_with_icon"
    repeat_char "$H" $right_padding
    printf "%s%s\n" "$TR" "$RESET"
}

draw_bottom_border() {
    local color="$1"
    printf "%s%s" "$color" "$BL"
    repeat_char "$H" $((WIDTH - 2))
    printf "%s%s\n" "$BR" "$RESET"
}

draw_separator() {
    local color="$1"
    printf "%s%s" "$color" "$L"
    repeat_char "$H" $((WIDTH - 2))
    printf "%s%s\n" "$R" "$RESET"
}

draw_empty_line() {
    local color="$1"
    printf "%s%s%s" "$color" "$V" "$RESET"
    printf "%$((WIDTH - 2))s"
    printf "%s%s%s\n" "$color" "$V" "$RESET"
}

draw_line() {
    local color="$1"
    shift
    local content="$*"

    # Strip ANSI codes for length calculation
    local stripped=$(echo "$content" | sed $'s/\033\\[[0-9;]*m//g')
    local visible_len=${#stripped}
    local padding=$((WIDTH - visible_len - 4))

    printf "%s%s%s  %s" "$color" "$V" "$RESET" "$content"
    [[ $padding -gt 0 ]] && printf "%${padding}s"
    printf "%s%s%s\n" "$color" "$V" "$RESET"
}

get_cached() {
    local name="$1"
    local cmd="$2"
    local cache_file="$CACHE_DIR/$name"

    if [[ -f "$cache_file" ]]; then
        local age=$(($(date +%s) - $(stat -f%m "$cache_file" 2>/dev/null || echo 0)))
        if [[ $age -lt $CACHE_TIMEOUT ]]; then
            cat "$cache_file"
            return
        fi
    fi

    eval "$cmd" 2>/dev/null | tee "$cache_file"
}

# ─────────────────────────────────────────────────────────────
# Header - Centered ASCII Art
# ─────────────────────────────────────────────────────────────

echo ""

printf "%s%s" "$PURPLE" "$BOLD"
center_text "██████╗ ███████╗██╗   ██╗███████╗███████╗████████╗ ██████╗██╗  ██╗" "$WIDTH"; echo
center_text "██╔══██╗██╔════╝██║   ██║██╔════╝██╔════╝╚══██╔══╝██╔════╝██║  ██║" "$WIDTH"; echo
center_text "██║  ██║█████╗  ██║   ██║█████╗  █████╗     ██║   ██║     ███████║" "$WIDTH"; echo
center_text "██║  ██║██╔══╝  ╚██╗ ██╔╝██╔══╝  ██╔══╝     ██║   ██║     ██╔══██║" "$WIDTH"; echo
center_text "██████╔╝███████╗ ╚████╔╝ ██║     ███████╗   ██║   ╚██████╗██║  ██║" "$WIDTH"; echo
center_text "╚═════╝ ╚══════╝  ╚═══╝  ╚═╝     ╚══════╝   ╚═╝    ╚═════╝╚═╝  ╚═╝" "$WIDTH"; echo
printf "%s" "$RESET"

printf "%s%s" "$DIM" "$GRAY"
center_text "developer dashboard" "$WIDTH"
printf "%s\n\n" "$RESET"

# ─────────────────────────────────────────────────────────────
# User & Auth Section
# ─────────────────────────────────────────────────────────────

draw_top_border "Session" "$USER_ICON" "$GRAY"
draw_empty_line "$GRAY"

# GitHub Auth Status
if command -v gh &> /dev/null; then
    gh_user=$(gh api user --jq '.login' 2>/dev/null)
    if [[ -n "$gh_user" ]]; then
        gh_name=$(gh api user --jq '.name // .login' 2>/dev/null)
        draw_line "$GRAY" "${GREEN}${CHECKMARK}${RESET} ${BOLD}GitHub${RESET}  ${DIM}logged in as${RESET} ${CYAN}@${gh_user}${RESET} ${DIM}(${gh_name})${RESET}"

        # Get contribution stats
        commits_today=$(get_cached "commits_today" "gh api graphql -f query='query { viewer { contributionsCollection { contributionCalendar { weeks { contributionDays { contributionCount date } } } } } }' --jq '[.data.viewer.contributionsCollection.contributionCalendar.weeks[-1].contributionDays[] | select(.date == \"'$(date +%Y-%m-%d)'\") | .contributionCount] | add // 0'" 2>/dev/null)
        commits_week=$(get_cached "commits_week" "gh api graphql -f query='query { viewer { contributionsCollection { contributionCalendar { weeks { contributionDays { contributionCount } } } } } }' --jq '[.data.viewer.contributionsCollection.contributionCalendar.weeks[-1].contributionDays[].contributionCount] | add'" 2>/dev/null)

        if [[ -n "$commits_today" && "$commits_today" != "null" ]]; then
            draw_line "$GRAY" "  ${DIM}${COMMIT_ICON} Contributions:${RESET} ${GREEN}${commits_today}${RESET} ${DIM}today${RESET}  ${DOT}  ${CYAN}${commits_week:-0}${RESET} ${DIM}this week${RESET}"
        fi
    else
        draw_line "$GRAY" "${RED}${CROSS}${RESET} ${BOLD}GitHub${RESET}  ${DIM}not authenticated${RESET}  ${YELLOW}run: gh auth login${RESET}"
    fi
else
    draw_line "$GRAY" "${RED}${CROSS}${RESET} ${BOLD}GitHub CLI${RESET}  ${DIM}not installed${RESET}  ${YELLOW}run: brew install gh${RESET}"
fi

# Linear Auth Status
if [[ -f "$HOME/.config/linear/config.json" ]]; then
    draw_line "$GRAY" "${GREEN}${CHECKMARK}${RESET} ${BOLD}Linear${RESET}  ${DIM}configured${RESET}"
else
    draw_line "$GRAY" "${YELLOW}${DOT}${RESET} ${BOLD}Linear${RESET}  ${DIM}not configured (optional)${RESET}"
fi

# Git user config
git_user=$(git config --global user.name 2>/dev/null)
git_email=$(git config --global user.email 2>/dev/null)
if [[ -n "$git_user" ]]; then
    draw_line "$GRAY" "${GREEN}${CHECKMARK}${RESET} ${BOLD}Git${RESET}  ${DIM}${git_user}${RESET} ${DIM}<${git_email}>${RESET}"
else
    draw_line "$GRAY" "${YELLOW}${DOT}${RESET} ${BOLD}Git${RESET}  ${DIM}user not configured${RESET}"
fi

draw_empty_line "$GRAY"
draw_bottom_border "$GRAY"
echo ""

# ─────────────────────────────────────────────────────────────
# GitHub Section
# ─────────────────────────────────────────────────────────────

if command -v gh &> /dev/null && gh auth status &>/dev/null; then

    draw_top_border "GitHub" "$GITHUB_ICON" "$BLUE"
    draw_empty_line "$BLUE"

    # My PRs
    draw_line "$BLUE" "${CYAN}${BOLD}${PR_ICON} My Pull Requests${RESET}"

    prs=$(get_cached "prs" "gh pr list --author @me --state open --limit 5 --json title,repository --jq '.[] | .repository.name + \": \" + .title'")
    if [[ -n "$prs" ]]; then
        while IFS= read -r pr; do
            draw_line "$BLUE" "  ${GREEN}${ARROW}${RESET} ${WHITE}${pr}${RESET}"
        done <<< "$prs"
    else
        draw_line "$BLUE" "  ${DIM}No open PRs${RESET}"
    fi

    draw_empty_line "$BLUE"
    draw_separator "$BLUE"
    draw_empty_line "$BLUE"

    # Issues Assigned
    draw_line "$BLUE" "${YELLOW}${BOLD}${ISSUE_ICON} Assigned Issues${RESET}"

    issues=$(get_cached "issues" "gh issue list --assignee @me --state open --limit 5 --json title,repository --jq '.[] | .repository.name + \": \" + .title'")
    if [[ -n "$issues" ]]; then
        while IFS= read -r issue; do
            draw_line "$BLUE" "  ${YELLOW}${ARROW}${RESET} ${WHITE}${issue}${RESET}"
        done <<< "$issues"
    else
        draw_line "$BLUE" "  ${DIM}No assigned issues${RESET}"
    fi

    draw_empty_line "$BLUE"
    draw_separator "$BLUE"
    draw_empty_line "$BLUE"

    # PRs to Review
    draw_line "$BLUE" "${PURPLE}${BOLD}${REVIEW_ICON} Review Requests${RESET}"

    reviews=$(get_cached "reviews" "gh pr list --search 'is:open review-requested:@me' --limit 5 --json title,repository --jq '.[] | .repository.name + \": \" + .title'")
    if [[ -n "$reviews" ]]; then
        while IFS= read -r review; do
            draw_line "$BLUE" "  ${PURPLE}${ARROW}${RESET} ${WHITE}${review}${RESET}"
        done <<< "$reviews"
    else
        draw_line "$BLUE" "  ${DIM}No PRs to review${RESET}"
    fi

    draw_empty_line "$BLUE"
    draw_bottom_border "$BLUE"
    echo ""
fi

# ─────────────────────────────────────────────────────────────
# Linear Section
# ─────────────────────────────────────────────────────────────

if command -v npx &> /dev/null && [[ -f "$HOME/.config/linear/config.json" ]] 2>/dev/null; then

    draw_top_border "Linear" "$LINEAR_ICON" "$PURPLE"
    draw_empty_line "$PURPLE"

    draw_line "$PURPLE" "${CYAN}${BOLD}${CHECK_ICON} My Issues${RESET}"

    linear=$(get_cached "linear" "npx -y @schpet/linear-cli list --limit 5 2>/dev/null")
    if [[ -n "$linear" ]]; then
        while IFS= read -r task; do
            draw_line "$PURPLE" "  ${CYAN}${ARROW}${RESET} ${WHITE}${task}${RESET}"
        done <<< "$linear"
    else
        draw_line "$PURPLE" "  ${DIM}No Linear issues${RESET}"
    fi

    draw_empty_line "$PURPLE"
    draw_bottom_border "$PURPLE"
    echo ""
fi

# ─────────────────────────────────────────────────────────────
# Footer
# ─────────────────────────────────────────────────────────────

printf "%s%s  " "$DIM" "$GRAY"
repeat_char "─" $((WIDTH - 4))
printf "%s\n" "$RESET"

footer="${BOLD}db${RESET}${DIM}${GRAY} dashboard  ${DOT}  ${RESET}${BOLD}dotup${RESET}${DIM}${GRAY} sync  ${DOT}  ${RESET}${BOLD}reload${RESET}${DIM}${GRAY} shell"
center_text "$footer" "$WIDTH"
echo ""

printf "%s%s  " "$DIM" "$GRAY"
repeat_char "─" $((WIDTH - 4))
printf "%s\n\n" "$RESET"
