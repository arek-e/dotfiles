# Ghostty Terminal Configuration
# ================================
# Fast, native terminal with Gruvbox theme

# ==============================================
# Shell / Herdr Integration
# ==============================================
# Auto-start herdr on FIRST window only (initial-command)
# - New tabs/splits get plain shell
# - Detaching from herdr drops you into shell (doesn't close Ghostty)
initial-command = ~/.config/ghostty/scripts/herdr-session.sh

# ==============================================
# Theme
# ==============================================
theme = Gruvbox Dark

# ==============================================
# Font Configuration
# ==============================================
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
adjust-cell-height = 30%
font-feature = calt
font-feature = liga
font-feature = zero

font-family-bold = "JetBrainsMono Nerd Font Mono"
font-family-italic = "JetBrainsMono Nerd Font Mono"
font-family-bold-italic = "JetBrainsMono Nerd Font Mono"

# ==============================================
# Window
# ==============================================
window-padding-x = 10
window-padding-y = 0
window-decoration = true
window-theme = dark
macos-titlebar-style = tabs
macos-option-as-alt = true
confirm-close-surface = false

# Window size
window-width = 160
window-height = 45

# Transparency
background-opacity = 0.92
background-blur-radius = 20

# ==============================================
# Cursor
# ==============================================
cursor-style = block
cursor-style-blink = true
cursor-opacity = 1.0
cursor-color = #ffffff
cursor-text = #000000
shell-integration-features = no-cursor

# ==============================================
# Mouse
# ==============================================
mouse-hide-while-typing = true
copy-on-select = clipboard

# ==============================================
# Scrollback
# ==============================================
scrollback-limit = 10000000

# ==============================================
# Clipboard
# ==============================================
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# ==============================================
# Keybindings
# ==============================================
# Splits (like tmux)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface

# Navigation
keybind = super+shift+left=goto_split:left
keybind = super+shift+right=goto_split:right
keybind = super+shift+up=goto_split:top
keybind = super+shift+down=goto_split:bottom

# Tabs
keybind = super+t=new_tab
keybind = super+shift+]=next_tab
keybind = super+shift+[=previous_tab

# Font size
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Quick actions
keybind = super+k=clear_screen
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard
keybind = super+shift+comma=reload_config

# ==============================================
# Performance
# ==============================================
gtk-single-instance = true
