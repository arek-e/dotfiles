# Ghostty Terminal Configuration
# ================================
# Fast, native terminal with One Dark Pro theme

# ==============================================
# Shell / Tmux Integration
# ==============================================
# Auto-start tmux on FIRST window only (initial-command)
# - New tabs/splits get plain shell (use tmux for multiplexing)
# - Detaching from tmux drops you into shell (doesn't close Ghostty)
initial-command = ~/.config/ghostty/scripts/tmux-session.sh

# ==============================================
# Theme - One Dark Pro
# ==============================================
# Explicit colors for consistency across all tools
background = 282c34
foreground = abb2bf
cursor-color = 528bff
selection-background = 3e4452
selection-foreground = abb2bf

# Normal colors (0-7)
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf

# Bright colors (8-15)
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#e5c07b
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#ffffff

# ==============================================
# Font Configuration
# ==============================================
font-family = "MonaspiceNe Nerd Font Mono"
font-size = 13
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

# Fallback fonts for symbols
font-family-bold = "MonaspiceNe Nerd Font Mono"
font-family-italic = "MonaspiceNe Nerd Font Mono"
font-family-bold-italic = "MonaspiceNe Nerd Font Mono"

# ==============================================
# Window
# ==============================================
window-padding-x = 0
window-padding-y = 0
window-decoration = true
window-theme = ghostty
macos-titlebar-style = tabs
macos-option-as-alt = true
confirm-close-surface = false

# Window size
window-width = 160
window-height = 45

# ==============================================
# Cursor
# ==============================================
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# ==============================================
# Mouse
# ==============================================
mouse-hide-while-typing = true
copy-on-select = clipboard

# ==============================================
# Scrollback
# ==============================================
scrollback-limit = 10000

# ==============================================
# Clipboard
# ==============================================
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# ==============================================
# Keybindings
# ==============================================
# Splits (like tmux)
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+w=close_surface

# Navigation
keybind = super+shift+left=goto_split:left
keybind = super+shift+right=goto_split:right
keybind = super+shift+up=goto_split:top
keybind = super+shift+down=goto_split:bottom

# Tabs
keybind = super+t=new_tab
keybind = super+shift+]=next_tab
keybind = super+shift+[=previous_tab

# Font size
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Quick actions
keybind = super+k=clear_screen
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard

# ==============================================
# Performance
# ==============================================
gtk-single-instance = true
